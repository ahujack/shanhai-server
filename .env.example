# Railway 会自动设置 DATABASE_URL
# 开发环境使用本地 PostgreSQL
# DATABASE_URL="postgresql://user:password@localhost:5432/shanhai?schema=public"

# JWT 密钥（生产环境请使用复杂的随机字符串）
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# 积分：默认不扣免费用户积分（测字/占卜等）。正式对用户扣分时设置：
# POINTS_GATE_ENFORCED=true
# 若已设了 ENFORCED 仍想临时关掉门闸，可设 DISABLE_POINTS_GATE=true（未设 ENFORCED 时默认已是关闭门闸）

# 多模态 (Gemini 等) — 测字识图、笔迹分析与识字共用同一套地址与 Key
LLM_API_KEY="your_gemini_api_key_here"
LLM_API_URL="https://api.apiyi.com/v1/chat/completions"
LLM_MODEL="gemini-2.5-flash"
# 可选：识字单独用更快/更便宜的模型（不填则用 LLM_MODEL；须支持 chat 多模态 image_url）
# LLM_OCR_MODEL="gemini-2.0-flash"
# 可选：LLM 识字单次请求超时（毫秒），默认 45000，上限 90000
# LLM_OCR_TIMEOUT_MS=45000
# 笔迹四维度（另一路请求，与识字独立）
# LLM_VISION_MODEL=
# LLM_VISION_TIMEOUT_MS=45000
#
# 可选：国内手写 OCR（百度手写 v1，有则优先于 LLM，延迟通常更低）
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
#
# 可选：本机 Paddle（Railway 默认 Node 镜像一般未启用）
# PADDLE_OCR_ENABLED=false
# PADDLE_OCR_SCRIPT=
# PADDLE_OCR_PYTHON=python3
#
# --- 手写识字故障排查（Railway 日志检索关键字）---
# 成功：「百度手写识字」「LLM 识字(」
# 失败：「百度OCR错误」「百度手写识字失败」「LLM 识字 API 错误」「LLM 识字失败」「识字流程异常」
# 流程：先百度(若配置) → 再 LLM → 再 Paddle(若启用) → 最后 SVG 文本；画布 SVG 通常无 <text>，兜底常为空字

# 纯文本 (DeepSeek) - 测字解读、八字解读、抽签、对话等
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_MODEL="deepseek-chat"

# 前端正式站（支付回调、CORS 白名单；Railway 上请与真实域名一致）
# FRONTEND_URL=https://www.shanhai.app
# ALLOWED_ORIGINS=https://www.shanhai.app,https://shanhai.app,http://localhost:8081

# --- Creem 支付 ---
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_API_URL=https://api.creem.io/v1
# 各商品在 Creem 后台创建后，将 prod_xxx 填到对应变量（覆盖代码内默认；积分包为一次性商品，需各建一个）
# CREEM_PRODUCT_VIP_MONTHLY=prod_xxx
# CREEM_PRODUCT_VIP_YEARLY=prod_xxx
# CREEM_PRODUCT_POINTS_100=prod_xxx
# CREEM_PRODUCT_POINTS_500=prod_xxx
# CREEM_PRODUCT_POINTS_1000=prod_xxx
# CREEM_PRODUCT_POINTS_3000=prod_xxx

# Google 登录
GOOGLE_CLIENT_ID="your_google_client_id"

# 邮件服务（可选，默认为模拟模式）
RESEND_API_KEY="your_resend_api_key"
